# Copy to .env and adjust. Never commit the real .env.
# Node does not read .env by itself. Without Docker, start the server with
#   node --env-file=.env bin/senselex.js serve
# With Docker, docker compose takes the tokens, CORS origins, audit secret and
# limits from this file. NODE_ENV, SENSELEX_HOST, SENSELEX_DATABASE_PATH and PORT
# are fixed by docker-compose.yml, so their values here apply only without Docker.

# Runtime
NODE_ENV=development
PORT=8787
SENSELEX_HOST=127.0.0.1

# Storage. Use an absolute path in production; ":memory:" is for tests only.
SENSELEX_DATABASE_PATH=./data/senselex.db

# Comma-separated bearer tokens allowed to write. REQUIRED in production.
# Generate with, for example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SENSELEX_API_TOKENS=

# Comma-separated browser origins allowed to call the API. Empty means same-origin only.
SENSELEX_CORS_ORIGINS=

# Limits
SENSELEX_MAX_BODY_BYTES=1000000
SENSELEX_MAX_PAGE_SIZE=200
SENSELEX_RATE_WINDOW_MS=60000
SENSELEX_RATE_MAX=240

# Keys the audit log's client-address digest (HMAC-SHA256). Leave empty and
# addresses are not recorded at all: an unkeyed hash of an IP address can be
# reversed by exhaustive search over the 2^32 IPv4 space, so it would still be
# personal data. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SENSELEX_AUDIT_SECRET=
